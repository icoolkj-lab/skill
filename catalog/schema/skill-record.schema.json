{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/icoolkj/skill/blob/main/catalog/schema/skill-record.schema.json",
  "title": "Skill Asset Record",
  "type": "object",
  "required": [
    "id",
    "asset_type",
    "name",
    "path",
    "category",
    "lifecycle_status",
    "source",
    "license",
    "review",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "asset_type": {
      "enum": [
        "skill",
        "skill-suite",
        "tool",
        "project",
        "template",
        "dataset",
        "reference",
        "other"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "child_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_or_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "collection_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "prohibited",
            "conditional",
            "unknown",
            "not_applicable"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "prohibited",
            "conditional",
            "unknown",
            "not_applicable"
          ]
        },
        "modification": {
          "enum": [
            "allowed",
            "prohibited",
            "conditional",
            "unknown",
            "not_applicable"
          ]
        },
        "review_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "incoming",
        "triage",
        "reviewed",
        "verified",
        "published",
        "archived",
        "rejected"
      ]
    },
    "quality_grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unrated"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "pending",
            "passed",
            "needs_changes",
            "blocked"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_tested",
            "static_checked",
            "tested",
            "failed",
            "not_applicable"
          ]
        },
        "tested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "environment": {
          "type": "string"
        },
        "test_notes": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
